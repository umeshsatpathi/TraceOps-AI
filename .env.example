# FalkorDB Database Connection
# For Local Docker:
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=traceshield

# For FalkorDB Cloud (managed cloud instance):
# FALKORDB_HOST=xyz.falkordb.cloud
# FALKORDB_PORT=6379
# FALKORDB_USERNAME=default
# FALKORDB_PASSWORD=your_cloud_password_here
# FALKORDB_SSL=true
# Or complete connection URI:
# FALKORDB_URL=falkordbs://default:your_cloud_password@xyz.falkordb.cloud:6379

# AI & LLM Configuration
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash-lite

# API & Cloud Deployment Configuration
# Comma-separated list of allowed frontend origins (e.g. for Vercel / Netlify):
# CORS_ORIGINS=https://traceshield-ai.vercel.app,https://your-custom-domain.com
PORT=8000

